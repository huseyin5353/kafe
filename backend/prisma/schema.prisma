generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id                        BigInt        @id @default(autoincrement())
  tenant_id                 BigInt?
  table_name                String        @db.VarChar(50)
  record_id                 BigInt
  action                    audit_action
  old_values                Json?
  new_values                Json?
  changed_by_user_id        BigInt?
  changed_by_super_admin_id BigInt?
  ip_address                String?       @db.Inet
  user_agent                String?
  created_at                DateTime?     @default(now()) @db.Timestamptz(6)
  super_admins              super_admins? @relation(fields: [changed_by_super_admin_id], references: [id], onUpdate: NoAction)
  users                     users?        @relation(fields: [changed_by_user_id], references: [id], onUpdate: NoAction)
  tenants                   tenants?      @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([changed_by_super_admin_id], map: "idx_audit_logs_super_admin_id")
  @@index([table_name, record_id], map: "idx_audit_logs_table_record")
  @@index([tenant_id], map: "idx_audit_logs_tenant_id")
  @@index([changed_by_user_id], map: "idx_audit_logs_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cart_items {
  id                   BigInt               @id @default(autoincrement())
  tenant_id            BigInt
  session_id           BigInt
  participant_id       BigInt
  menu_item_id         BigInt
  quantity             Int
  unit_price           Decimal              @db.Decimal(10, 2)
  total_price          Decimal              @db.Decimal(10, 2)
  special_note         String?
  is_confirmed         Boolean?             @default(false)
  confirmed_at         DateTime?            @db.Timestamptz(6)
  added_at             DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?            @default(now()) @db.Timestamptz(6)
  menu_item            menu_item            @relation(fields: [menu_item_id], references: [id], onUpdate: NoAction)
  session_participants session_participants @relation(fields: [participant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  table_session        table_session        @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants              tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([menu_item_id], map: "idx_cart_items_menu_item_id")
  @@index([participant_id], map: "idx_cart_items_participant_id")
  @@index([session_id], map: "idx_cart_items_session_id")
  @@index([tenant_id], map: "idx_cart_items_tenant_id")
}

model category {
  id            BigInt         @id @default(autoincrement())
  tenant_id     BigInt
  department_id BigInt
  name          String         @db.VarChar(255)
  sort_order    Int?           @default(0)
  is_active     Boolean?       @default(true)
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  departments   departments    @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants       tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sub_category  sub_category[]

  @@unique([tenant_id, department_id, name])
  @@index([department_id], map: "idx_category_department_id")
  @@index([tenant_id], map: "idx_category_tenant_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model customers {
  id                   BigInt                 @id @default(autoincrement())
  tenant_id            BigInt
  full_name            String                 @db.VarChar(255)
  phone                String?                @db.VarChar(20)
  email                String?                @db.VarChar(255)
  password_hash        String?                @db.VarChar(255)
  is_active            Boolean?               @default(true)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  tenants              tenants                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session_participants session_participants[]
  session_reviews      session_reviews[]

  @@unique([tenant_id, email])
  @@unique([tenant_id, phone])
  @@index([email], map: "idx_customers_email")
  @@index([phone], map: "idx_customers_phone")
  @@index([tenant_id], map: "idx_customers_tenant_id")
}

model departments {
  id          BigInt      @id @default(autoincrement())
  tenant_id   BigInt
  name        String      @db.VarChar(255)
  description String?     @db.VarChar(255)
  icon_name   String?     @db.VarChar(255)
  color_code  String?     @db.VarChar(7)
  is_active   Boolean?    @default(true)
  sort_order  Int?        @default(0)
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  category    category[]
  tenants     tenants     @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_item   menu_item[]

  @@unique([tenant_id, name])
  @@index([tenant_id], map: "idx_departments_tenant_id")
}

model login_history {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  login_at   DateTime? @default(now()) @db.Timestamptz(6)
  ip_address String?   @db.Inet
  user_agent String?
  success    Boolean?  @default(true)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_login_history_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model menu_item {
  id               BigInt          @id @default(autoincrement())
  tenant_id        BigInt
  department_id    BigInt
  subcategory_id   BigInt?
  name             String          @db.VarChar(255)
  price            Decimal         @db.Decimal(10, 2)
  description      String?
  is_available     Boolean?        @default(true)
  image_url        String?         @db.VarChar(500)
  calories         Int?
  protein          Decimal?        @db.Decimal(5, 2)
  carbs            Decimal?        @db.Decimal(5, 2)
  fat              Decimal?        @db.Decimal(5, 2)
  preparation_time Int?
  spice_level      Int?
  is_vegetarian    Boolean?        @default(false)
  is_vegan         Boolean?        @default(false)
  is_gluten_free   Boolean?        @default(false)
  ingredients      String?
  allergens        String?
  sort_order       Int?            @default(0)
  is_active        Boolean?        @default(true)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?       @default(now()) @db.Timestamptz(6)
  cart_items       cart_items[]
  departments      departments     @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sub_category     sub_category?   @relation(fields: [subcategory_id], references: [id], onUpdate: NoAction)
  tenants          tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_items      order_items[]
  product_stats    product_stats[]

  @@unique([tenant_id, department_id, name])
  @@index([department_id], map: "idx_menu_item_department_id")
  @@index([is_available], map: "idx_menu_item_is_available")
  @@index([subcategory_id], map: "idx_menu_item_subcategory_id")
  @@index([tenant_id], map: "idx_menu_item_tenant_id")
}

model notifications {
  id            BigInt                 @id @default(autoincrement())
  tenant_id     BigInt
  user_id       BigInt?
  session_id    BigInt?
  title         String                 @db.VarChar(255)
  message       String
  type          notification_type
  priority      notification_priority? @default(normal)
  target_role   target_role?           @default(all)
  is_read       Boolean?               @default(false)
  read_at       DateTime?              @db.Timestamptz(6)
  created_at    DateTime?              @default(now()) @db.Timestamptz(6)
  table_session table_session?         @relation(fields: [session_id], references: [id], onUpdate: NoAction)
  tenants       tenants                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_read], map: "idx_notifications_is_read")
  @@index([session_id], map: "idx_notifications_session_id")
  @@index([tenant_id], map: "idx_notifications_tenant_id")
  @@index([type], map: "idx_notifications_type")
  @@index([user_id], map: "idx_notifications_user_id")
}

